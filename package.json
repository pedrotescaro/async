{
  "name": "async-desktop",
  "desktopName": "dev.async.desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source desktop writing assistant for students and developers.",
  "author": {
    "name": "Pedro Tescaro",
    "email": "133606054+pedrotescaro@users.noreply.github.com"
  },
  "homepage": "https://github.com/pedrotescaro/async",
  "repository": {
    "type": "git",
    "url": "https://github.com/pedrotescaro/async.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.js",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "vite",
    "dev:site": "vite --config vite.site.config.ts",
    "typecheck": "tsc -b",
    "build:desktop": "tsc -b && vite build",
    "build:site": "vite build --config vite.site.config.ts",
    "build": "tsc -b && vite build && vite build --config vite.site.config.ts",
    "preview:site": "vite preview --config vite.site.config.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:win": "tsc -b && vite build && electron-builder --win nsis --x64 --publish never",
    "package:linux": "tsc -b && vite build && electron-builder --linux AppImage deb --x64 --publish never",
    "ai:pull": "ollama pull qwen3:8b",
    "ai:create": "ollama create async -f ai/Modelfile",
    "ai:run": "ollama run async"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@phosphor-icons/react": "^2.1.10",
    "electron-updater": "^6.8.3",
    "highlight.js": "^11.11.1",
    "motion": "^12.23.26",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.4",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "jsdom": "^27.2.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.0.15"
  }
}
